import 'package:flutter/material.dart';
import 'package:flutter_boilerplate/ui/app/edit_scaffold.dart';
import 'package:flutter_boilerplate/ui/app/form_card.dart';
import 'package:flutter_boilerplate/ui/social/edit/social_edit_vm.dart';
import 'package:flutter_boilerplate/utils/localization.dart';
import 'package:flutter_boilerplate/utils/completers.dart';
import 'package:flutter_boilerplate/ui/app/scrollable_listview.dart';

class SocialEdit extends StatefulWidget {
  const SocialEdit({
    Key? key,
    required this.viewModel,
  }) : super(key: key);

  final SocialEditVM viewModel;

  @override
  _SocialEditState createState() => _SocialEditState();
}

class _SocialEditState extends State<SocialEdit> {
  static final GlobalKey<FormState> _formKey = GlobalKey<FormState>(debugLabel: '_socialEdit');
  final _debouncer = Debouncer();

  // STARTER: controllers - do not remove comment
final _userDisplayNameController = TextEditingController();
final _userPhotoUrlController = TextEditingController();
final _contentController = TextEditingController();
final _photosController = TextEditingController();
final _categoryController = TextEditingController();
final _likeCountController = TextEditingController();
final _commentCountController = TextEditingController();
final _tagsController = TextEditingController();
  List<TextEditingController> _controllers = [];

  @override
  void didChangeDependencies() {
    _controllers = [
      // STARTER: array - do not remove comment
_userDisplayNameController,
_userPhotoUrlController,
_contentController,
_photosController,
_categoryController,
_likeCountController,
_commentCountController,
_tagsController,
    ];

    _controllers.forEach((controller) => controller.removeListener(_onChanged));

    final social = widget.viewModel.social;
    // STARTER: read value - do not remove comment
_userDisplayNameController.text = social.userDisplayName.toString();
_userPhotoUrlController.text = social.userPhotoUrl.toString();
_contentController.text = social.content.toString();
_photosController.text = social.photos.toString();
_categoryController.text = social.category.toString();
_likeCountController.text = social.likeCount.toString();
_commentCountController.text = social.commentCount.toString();
_tagsController.text = social.tags.toString();

    _controllers.forEach((controller) => controller.addListener(_onChanged));

    super.didChangeDependencies();
  }

  @override
  void dispose() {
    _controllers.forEach((controller) {
      controller.removeListener(_onChanged);
      controller.dispose();
    });

    super.dispose();
  }

  void _onChanged() {
    _debouncer.run(() {
      final social = widget.viewModel.social.rebuild((b) => b
        // STARTER: set value - do not remove comment
..userDisplayName = _userDisplayNameController.text.trim()
..userPhotoUrl = _userPhotoUrlController.text.trim()
..content = _contentController.text.trim()
..photos = _photosController.text.trim()
..category = _categoryController.text.trim()
..likeCount = int.tryParse(_likeCountController.text.trim()) ?? 0
..commentCount = int.tryParse(_commentCountController.text.trim()) ?? 0
..tags = _tagsController.text.trim()
      );
      if (social != widget.viewModel.social) {
        widget.viewModel.onChanged(social);
      }
    });
  }

  @override
  Widget build(BuildContext context) {
    final viewModel = widget.viewModel;
    final localization = AppLocalization.of(context)!;
    final social = viewModel.social;

    return EditScaffold(
      title: social.isNew ? localization.newSocial : localization.editSocial,
      onCancelPressed: (context) => viewModel.onCancelPressed(context),
      onSavePressed: (context) {
        final bool isValid = _formKey.currentState!.validate();
        if (!isValid) {
          return;
        }
        viewModel.onSavePressed(context);
      },
      entity: social,
      body: Form(
        key: _formKey,
        child: Builder(builder: (BuildContext context) {
          return ScrollableListView(
            children: <Widget>[
              FormCard(
                children: <Widget>[
                  // STARTER: widgets - do not remove comment
TextFormField(controller: _userPhotoUrlController,autocorrect: false,decoration: InputDecoration(labelText: 'UserPhotoUrl',),),
TextFormField(controller: _contentController,autocorrect: false,decoration: InputDecoration(labelText: 'Content',),),
TextFormField(controller: _photosController,autocorrect: false,decoration: InputDecoration(labelText: 'Photos',),),
TextFormField(controller: _categoryController,autocorrect: false,decoration: InputDecoration(labelText: 'Category',),),
TextFormField(controller: _likeCountController,autocorrect: false,keyboardType: TextInputType.number,decoration: InputDecoration(labelText: 'LikeCount',),),
TextFormField(controller: _commentCountController,autocorrect: false,keyboardType: TextInputType.number,decoration: InputDecoration(labelText: 'CommentCount',),),
TextFormField(controller: _tagsController,autocorrect: false,decoration: InputDecoration(labelText: 'Tags',),),
                ],
              ),
            ],
          );
        }),
      ),
    );
  }
}
