import 'dart:async';
import 'package:built_value/built_value.dart';
import 'package:built_value/serializer.dart';
import 'package:built_collection/built_collection.dart';
import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:flutter_boilerplate/redux/ui/entity_ui_state.dart';
import 'package:flutter_boilerplate/redux/ui/list_ui_state.dart';
import 'package:flutter_boilerplate/data/models/models.dart';
import 'package:flutter_boilerplate/redux/ui/pref_state.dart';

part 'photo_state.g.dart';

abstract class PhotoState implements Built<PhotoState, PhotoStateBuilder> {
  factory PhotoState() {
    return _$PhotoState._(
      map: BuiltMap<String, PhotoEntity>(),
      list: BuiltList<String>(),
      lastDocument: null,
      filter: PhotoFilter(),
    );
  }
  PhotoState._();

  @override
  @memoized
  int get hashCode;

  BuiltMap<String, PhotoEntity> get map;
  BuiltList<String> get list;

  DocumentSnapshot? get lastDocument;
  PhotoFilter get filter;

  PhotoEntity get(String photoId) {
    return map[photoId] ?? PhotoEntity(id: photoId);
  }

  PhotoState loadPhotos(BuiltList<PhotoEntity> clients) {
    final map = Map<String, PhotoEntity>.fromIterable(
      clients,
      key: (dynamic item) => item.id,
      value: (dynamic item) => item,
    );

    return rebuild((b) => b
      ..map.addAll(map)
      ..list.replace((map.keys.toList() + list.toList()).toSet().toList()));
  }

  static Serializer<PhotoState> get serializer => _$photoStateSerializer;
}

abstract class PhotoUIState extends Object
    with EntityUIState
    implements Built<PhotoUIState, PhotoUIStateBuilder> {
  factory PhotoUIState(PrefStateSortField? sortField) {
    return _$PhotoUIState._(
      listUIState: ListUIState(
        // STARTER: primary field - do not remove comment
        sortAscending: sortField?.ascending,
      ),
      editing: PhotoEntity(),
      selectedId: '',
      tabIndex: 0,
    );
  }
  PhotoUIState._();

  @override
  @memoized
  int get hashCode;

  PhotoEntity? get editing;

  @override
  bool get isCreatingNew => editing?.isNew ?? false;

  @override
  String get editingId => editing?.id ?? '';

  static Serializer<PhotoUIState> get serializer => _$photoUIStateSerializer;
}
