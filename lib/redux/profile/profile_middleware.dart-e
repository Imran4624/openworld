}

Middleware<AppState> _saveStub(StubRepository repository) {
  return (Store<AppState> store, dynamic dynamicAction, NextDispatcher next) {
    final action = dynamicAction as SaveStubRequest;
    repository
        .saveData(store.state.credentials, action.profile!)
        .then((StubEntity profile) {
      if (action.profile!.isNew) {
        store.dispatch(AddStubSuccess(profile));
      } else {
        store.dispatch(SaveStubSuccess(profile));
      }

      action.completer?.complete(profile);
    }).catchError((Object error) {
      printL(error);
      store.dispatch(SaveStubFailure(error));
      action.completer?.completeError(error);
    });

    next(action);
  };
}

Middleware<AppState> _loadStub(StubRepository repository) {
  return (Store<AppState> store, dynamic dynamicAction, NextDispatcher next) {
    final action = dynamicAction as LoadStub;

    store.dispatch(LoadStubRequest());
    repository
        .loadItem(store.state.credentials, action.profileId!)
        .then((profile) {
      store.dispatch(LoadStubSuccess(profile));
      action.completer?.complete(null);
    }).catchError((Object error) {
      printL(error);
      store.dispatch(LoadStubFailure(error));
      action.completer?.completeError(error);
    });

    next(action);
  };
}

Middleware<AppState> _loadStubs(StubRepository repository) {
  return (Store<AppState> store, dynamic dynamicAction, NextDispatcher next) {
    if (store.state.isLoading) {
      return;
    }

    final action = dynamicAction as LoadStubs;
    final state = store.state;// Get current state filter from listUIState
    final stateFilters = state.profileListState.stateFilters;
    final currentFilter = action.filter ?? state.profileState.filter;
    
    // Update filter with current state filter from listUIState
    final filter = currentFilter.rebuild((b) {
      if (stateFilters.isNotEmpty) {
        b.stateFilter = stateFilters.first; // Use the first state filter
      } else {
        b.stateFilter = EntityState.active; // Default to active
      }
    });
    store.dispatch(LoadStubsRequest(filter: filter));
    
    var lastDocument = state.profileState.lastDocument;
    if (action.isRefresh) {
      lastDocument = null;
      store.dispatch(UpdateLastDocumentAction(null));
    }

    repository
        .loadListWithPagination(
          lastDocument: lastDocument,
          limit: filter.limit,
          filter: filter,
        )
        .then((response) {
      final profiles = response['profiles'] as BuiltList<StubEntity>;
      final newLastDocument = response['lastDocument'] as DocumentSnapshot?;

      store.dispatch(LoadStubsSuccess(profiles));
      if (profiles.isNotEmpty) {
        store.dispatch(UpdateLastDocumentAction(newLastDocument));
      }
      action.completer?.complete(null);
    }).catchError((Object error) {
      printL(error);
      store.dispatch(LoadStubsFailure(error));
      action.completer?.completeError(error);
    });

    next(action);
  };
}
Middleware<AppState> _updateFilter(StubRepository repository) {
  return (Store<AppState> store, dynamic dynamicAction, NextDispatcher next) {
    final action = dynamicAction as UpdateStubFilter;

    next(action);

    store.dispatch(LoadStubs(
      filter: action.filter,
      isRefresh: true,
    ));
  };
}