//   return profileState.rebuild((b) {
//     for (final profile in action.profiles) {
//       b.map[profile.id] = profile;
//     }
//   });
// } 

StubState _deleteStubSuccess(
    StubState profileState, DeleteStubsSuccess action) {
  return profileState.rebuild((b) {
    for (final profile in action.profiles) {
      b.map[profile.id] = profileState.map[profile.id]!.rebuild((b) => b
        ..isDeleted = true);
    }
  });
}

StubState _purgeStubSuccess(
    StubState profileState, PurgeStubsSuccess action) {
  return profileState.rebuild((b) {
    for (final profile in action.profiles) {
      b.map.remove(profile.id);
      b.list.remove(profile.id);
    }
  });
}

StubState _restoreStubSuccess(
    StubState profileState, RestoreStubsSuccess action) {
  return profileState.rebuild((b) {
    for (final profile in action.profiles) {
      b.map[profile.id] = profileState.map[profile.id]!.rebuild((b) => b
        ..isDeleted = false
        ..archivedAt = 0);
    }
  });
}

StubState _addStub(StubState profileState, AddStubSuccess action) {
  return profileState.rebuild((b) => b
    ..map[action.profile.id] = action.profile
    ..list.add(action.profile.id));
}

StubState _updateStub(StubState profileState, SaveStubSuccess action) {
  return profileState.rebuild((b) => b..map[action.profile.id] = action.profile);
}
StubState _updateLastDocument(
    StubState profileState, UpdateLastDocumentAction action) {
  return profileState.rebuild((b) => b..lastDocument = action.lastDocument);
}

StubState _setLoadedStub(StubState profileState, LoadStubSuccess action) {
  return profileState.rebuild((b) => b..map[action.profile.id] = action.profile);
}

StubState _setLoadedStubs(
    StubState profileState, LoadStubsSuccess action) {
  return profileState.rebuild((b) {
    action.profiles.forEach((profile) {
      b.map[profile.id] = profile;
      if (!b.list.build().contains(profile.id)) {
        b.list.add(profile.id);
      }
    });
  });
}

