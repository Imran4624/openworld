import 'package:flutter/material.dart';
import 'package:flutter_redux/flutter_redux.dart';
import 'package:flutter_boilerplate/data/models/models.dart';
import 'package:flutter_boilerplate/redux/app/app_actions.dart';
import 'package:flutter_boilerplate/redux/app/app_state.dart';
import 'package:flutter_boilerplate/redux/chat/chat_actions.dart';
import 'package:flutter_boilerplate/ui/app/app_bottom_bar.dart';
import 'package:flutter_boilerplate/ui/app/list_scaffold.dart';
import 'package:flutter_boilerplate/ui/app/list_filter.dart';
import 'package:flutter_boilerplate/ui/chat/chat_list_vm.dart';
import 'package:flutter_boilerplate/ui/chat/chat_presenter.dart';
import 'package:flutter_boilerplate/utils/localization.dart';

import 'chat_screen_vm.dart';

class ChatScreen extends StatelessWidget {
  const ChatScreen({
    Key? key,
    required this.viewModel,
  }) : super(key: key);

  static const String route = '/chat';

  final ChatScreenVM viewModel;

  @override
  Widget build(BuildContext context) {
    final store = StoreProvider.of<AppState>(context);
    final state = store.state;
    final userCompany = state.userCompany;
    final localization = AppLocalization.of(context)!;

    return ListScaffold(
      entityType: EntityType.chat,
      onHamburgerLongPress: () => store.dispatch(StartChatMultiselect()),
      appBarTitle: ListFilter(
        key: ValueKey('__filter_${state.chatListState.filterClearedAt}__'),
        entityType: EntityType.chat,
        entityIds: viewModel.chatList,
         filter: state.chatState.filter.searchTerm,
        onFilterChanged: (value) {
          store.dispatch(FilterChats(value!));
          store.dispatch(UpdateChatFilter(
            state.chatState.filter.rebuild((b) => b
              ..searchTerm = value ?? ''
            ),
          ));
        },
        onSelectedState: (EntityState filterState, bool? value) {
          
          store.dispatch(FilterChatsByState(filterState));
          if (value ?? false) {
            store.dispatch(UpdateChatFilter(
              state.chatState.filter.rebuild((b) => b
                ..stateFilter = filterState
              ),
            ));
          }
          // printL('chatFilter state ==> ${state.chatState}');
        },
        selectedStateFilter: state.chatState.filter.stateFilter,
      ),
      onCheckboxPressed: () {
        if (store.state.chatListState.isInMultiselect()) {
          store.dispatch(ClearChatMultiselect());
        } else {
          store.dispatch(StartChatMultiselect());
        }
      },
      body: ChatListBuilder(),
      bottomNavigationBar: AppBottomBar(
        entityType: EntityType.chat,
        tableColumns: ChatPresenter.getAllTableFields(userCompany),
        defaultTableColumns: ChatPresenter.getDefaultTableFields(userCompany),
        onSelectedSortField: (field) {
          final ascending = state.chatState.filter.sortField == field 
              ? !state.chatState.filter.sortAscending 
              : true;
          store.dispatch(UpdateChatFilter(
            state.chatState.filter.rebuild((b) => b
              ..sortField = field
              ..sortAscending = ascending
            ),
          ));
        },
        sortFields: [
          // STARTER: constant fields - do not remove comment
ChatFields.isGroupChat,

ChatFields.groupName,

ChatFields.status,

ChatFields.centityType,

ChatFields.centityId,

ChatFields.groupThumbnail,

ChatFields.lastMessage,

ChatFields.lastActive,

ChatFields.unreadCount,

        ],
         onSelectedState: (EntityState filterState, bool? value) {
          store.dispatch(FilterChatsByState(filterState));
          if (value ?? false) {
            store.dispatch(UpdateChatFilter(
              state.chatState.filter.rebuild((b) => b
                ..stateFilter = filterState
              ),
            ));
          }
        },
        onCheckboxPressed: () {
          if (store.state.chatListState.isInMultiselect()) {
            store.dispatch(ClearChatMultiselect());
          } else {
            store.dispatch(StartChatMultiselect());
          }
        },
        // // customValues1: userCompany.getCustomFieldValues(CustomFieldType.chat1,
        // //     excludeBlank: true),
        // // customValues2: userCompany.getCustomFieldValues(CustomFieldType.chat2,
        // //     excludeBlank: true),
        // // customValues3: userCompany.getCustomFieldValues(CustomFieldType.chat3,
        // //     excludeBlank: true),
        // // customValues4: userCompany.getCustomFieldValues(CustomFieldType.chat4,
        //     excludeBlank: true),
        // onSelectedCustom1: (value) =>
        //     store.dispatch(FilterChatsByCustom1(value)),
        // onSelectedCustom2: (value) =>
        //     store.dispatch(FilterChatsByCustom2(value)),
        // onSelectedCustom3: (value) =>
        //     store.dispatch(FilterChatsByCustom3(value)),
        // onSelectedCustom4: (value) =>
        //     store.dispatch(FilterChatsByCustom4(value)),
      ),
      floatingActionButton: state.prefState.isMenuFloated &&
              userCompany.canCreate(EntityType.chat)
          ? FloatingActionButton(
              heroTag: 'chat_fab',
              backgroundColor: Theme.of(context).primaryColorDark,
              onPressed: () {
                createEntityByType(
                    context: context, entityType: EntityType.chat);
              },
              child: Icon(
                Icons.add,
                color: Colors.white,
              ),
              tooltip: localization.newChat,
            )
          : null,
    );
  }
}
