abstract class PaymentEntity extends Object
    with BaseEntity
    implements Built<PaymentEntity, PaymentEntityBuilder> {
  factory PaymentEntity({String? id, AppState? state}) {
    return _$PaymentEntity._(
      id: id ?? BaseEntity.nextId,
      isChanged: false,
      isDeleted: false,
      createdAt: 0,
      updatedAt: 0,
      createdUserId: '',
      assignedUserId: '',
      archivedAt: 0,
      // STARTER: constructor - do not remove comment
id: '',
idempotencyKey: '',
isChanged: false,
amount: 0.0,
transactionReference: '',
date: '',
typeId: '',
privateNotes: '',
exchangeRate: 0.0,
exchangeCurrencyId: '',
refunded: 0.0,
applied: 0.0,
statusId: '',
updatedAt: 0,
archivedAt: 0,
isDeleted: false,
isManual: false,
paymentables: '',
invoices: '',
assignedUserId: '',
createdAt: 0,
createdUserId: '',
number: '',
sendEmail: false,
companyGatewayId: '',
clientContactId: '',
currencyId: '',
transactionId: '',
invitationId: '',
isApplying: false,
    );
  }

  PaymentEntity._();

  @override
  @memoized
  int get hashCode;

  // STARTER: properties - do not remove comment
String get id;
String get idempotencyKey;
bool get isChanged;
double get amount;
String get transactionReference;
String get date;
String get typeId;
String get privateNotes;
double get exchangeRate;
String get exchangeCurrencyId;
double get refunded;
double get applied;
String get statusId;
int get updatedAt;
int get archivedAt;
bool get isDeleted;
bool get isManual;
String get paymentables;
String get invoices;
String get assignedUserId;
int get createdAt;
String get createdUserId;
String get number;
bool get sendEmail;
String get companyGatewayId;
String get clientContactId;
String get currencyId;
String get transactionId;
String get invitationId;
bool get isApplying;

  @override
  EntityType get entityType => EntityType.payment;

  @override
  List<EntityAction?> getActions({
    UserCompanyEntity? userCompany,
    bool includeEdit = false,
    bool multiselect = false,
  }) {
    final actions = <EntityAction?>[];

    if (!isDeleted! && !multiselect && includeEdit && userCompany?.canEditEntity(this) == true) {
      actions.add(EntityAction.edit);
    }

    if (!multiselect && userCompany?.canEditEntity(this) == true) {
      actions.add(EntityAction.purge);
    }

    if (actions.isNotEmpty) {
      actions.add(null);
    }

    return actions..addAll(super.getActions(userCompany: userCompany));
  }

  int compareTo(PaymentEntity payment, String sortField, bool sortAscending) {
    int response = 0;
    final paymentA = sortAscending ? this : payment;
    final paymentB = sortAscending ? payment : this;

    switch (sortField) {
      // STARTER: sort switch - do not remove comment
case PaymentFields.id:
response = paymentA.id.compareTo(paymentB.id);
break;

case PaymentFields.idempotencyKey:
response = paymentA.idempotencyKey.compareTo(paymentB.idempotencyKey);
break;

case PaymentFields.transactionReference:
response = paymentA.transactionReference.compareTo(paymentB.transactionReference);
break;

case PaymentFields.date:
response = paymentA.date.compareTo(paymentB.date);
break;

case PaymentFields.typeId:
response = paymentA.typeId.compareTo(paymentB.typeId);
break;

case PaymentFields.privateNotes:
response = paymentA.privateNotes.compareTo(paymentB.privateNotes);
break;

case PaymentFields.exchangeCurrencyId:
response = paymentA.exchangeCurrencyId.compareTo(paymentB.exchangeCurrencyId);
break;

case PaymentFields.statusId:
response = paymentA.statusId.compareTo(paymentB.statusId);
break;

case PaymentFields.paymentables:
response = paymentA.paymentables.compareTo(paymentB.paymentables);
break;

case PaymentFields.invoices:
response = paymentA.invoices.compareTo(paymentB.invoices);
break;

case PaymentFields.assignedUserId:
response = paymentA.assignedUserId.compareTo(paymentB.assignedUserId);
break;

case PaymentFields.createdUserId:
response = paymentA.createdUserId.compareTo(paymentB.createdUserId);
break;

case PaymentFields.number:
response = paymentA.number.compareTo(paymentB.number);
break;

case PaymentFields.companyGatewayId:
response = paymentA.companyGatewayId.compareTo(paymentB.companyGatewayId);
break;

case PaymentFields.clientContactId:
response = paymentA.clientContactId.compareTo(paymentB.clientContactId);
break;

case PaymentFields.currencyId:
response = paymentA.currencyId.compareTo(paymentB.currencyId);
break;

case PaymentFields.transactionId:
response = paymentA.transactionId.compareTo(paymentB.transactionId);
break;

case PaymentFields.invitationId:
response = paymentA.invitationId.compareTo(paymentB.invitationId);
break;

      default:
        print(' ERROR: sort by payment.$sortField is not implemented');
        break;
    }

    if (response == 0) {
      // STARTER: sort default - do not remove comment
    } else {
      return response;
    }
  }

  @override
  bool matchesFilter(String? filter) {
    return matchesStrings(
      haystacks: [
      // STARTER: field names - do not remove comment
id,
idempotencyKey,
transactionReference,
date,
typeId,
privateNotes,
exchangeCurrencyId,
statusId,
paymentables,
invoices,
assignedUserId,
createdUserId,
number,
companyGatewayId,
clientContactId,
currencyId,
transactionId,
invitationId,
      ],
      needle: filter,
    );
  }

  @override
  String? matchesFilterValue(String? filter) {
    return matchesStringsValue(
      haystacks: [
      // STARTER: field names - do not remove comment
id,
idempotencyKey,
transactionReference,
date,
typeId,
privateNotes,
exchangeCurrencyId,
statusId,
paymentables,
invoices,
assignedUserId,
createdUserId,
number,
companyGatewayId,
clientContactId,
currencyId,
transactionId,
invitationId,
      ],
      needle: filter,
    )!;
  }

  @override
  String get listDisplayName => '';

  @override
  double get listDisplayAmount => 0;

  @override
  FormatNumberType get listDisplayAmountType => FormatNumberType.int;

  static Serializer<PaymentEntity> get serializer => _$paymentEntitySerializer;
}
