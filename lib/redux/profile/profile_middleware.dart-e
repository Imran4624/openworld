Middleware<AppState> _restoreStub(StubRepository repository) {
  return (Store<AppState> store, dynamic dynamicAction, NextDispatcher next) {
    final action = dynamicAction as RestoreStubsRequest;
    final prevStubs = action.profileIds
        .map((id) => store.state.profileState.map[id])
        .whereType<StubEntity>()
        .toList();

    repository
        .bulkAction(store.state.credentials, action.profileIds, EntityAction.restore)
        .then((List<StubEntity> profiles) {
      store.dispatch(RestoreStubsSuccess(profiles));
      action.completer.complete(null);
    }).catchError((Object error) {
      printL(error);
