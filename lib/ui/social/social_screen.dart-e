import 'package:flutter/material.dart';
import 'package:flutter_redux/flutter_redux.dart';
import 'package:flutter_boilerplate/data/models/models.dart';
import 'package:flutter_boilerplate/redux/app/app_actions.dart';
import 'package:flutter_boilerplate/redux/app/app_state.dart';
import 'package:flutter_boilerplate/redux/social/social_actions.dart';
import 'package:flutter_boilerplate/ui/app/app_bottom_bar.dart';
import 'package:flutter_boilerplate/ui/app/list_scaffold.dart';
import 'package:flutter_boilerplate/ui/app/list_filter.dart';
import 'package:flutter_boilerplate/ui/social/social_list_vm.dart';
import 'package:flutter_boilerplate/ui/social/social_presenter.dart';
import 'package:flutter_boilerplate/utils/localization.dart';

import 'social_screen_vm.dart';

class SocialScreen extends StatelessWidget {
  const SocialScreen({
    Key? key,
    required this.viewModel,
  }) : super(key: key);

  static const String route = '/social';

  final SocialScreenVM viewModel;

  @override
  Widget build(BuildContext context) {
    final store = StoreProvider.of<AppState>(context);
    final state = store.state;
    final userCompany = state.userCompany;
    final localization = AppLocalization.of(context)!;

    return ListScaffold(
      entityType: EntityType.social,
      onHamburgerLongPress: () => store.dispatch(StartSocialMultiselect()),
      appBarTitle: ListFilter(
        key: ValueKey('__filter_${state.socialListState.filterClearedAt}__'),
        entityType: EntityType.social,
        entityIds: viewModel.socialList,
         filter: state.socialState.filter.searchTerm,
        onFilterChanged: (value) {
          store.dispatch(FilterSocials(value!));
          store.dispatch(UpdateSocialFilter(
            state.socialState.filter.rebuild((b) => b
              ..searchTerm = value ?? ''
            ),
          ));
        },
        onSelectedState: (EntityState filterState, bool? value) {
          
          store.dispatch(FilterSocialsByState(filterState));
          if (value ?? false) {
            store.dispatch(UpdateSocialFilter(
              state.socialState.filter.rebuild((b) => b
                ..stateFilter = filterState
              ),
            ));
          }
          // print('socialFilter state ==> ${state.socialState}');
        },
        selectedStateFilter: state.socialState.filter.stateFilter,
      ),
      onCheckboxPressed: () {
        if (store.state.socialListState.isInMultiselect()) {
          store.dispatch(ClearSocialMultiselect());
        } else {
          store.dispatch(StartSocialMultiselect());
        }
      },
      body: SocialListBuilder(),
      bottomNavigationBar: AppBottomBar(
        entityType: EntityType.social,
        tableColumns: SocialPresenter.getAllTableFields(userCompany),
        defaultTableColumns: SocialPresenter.getDefaultTableFields(userCompany),
        onSelectedSortField: (field) {
          final ascending = state.socialState.filter.sortField == field 
              ? !state.socialState.filter.sortAscending 
              : true;
          store.dispatch(UpdateSocialFilter(
            state.socialState.filter.rebuild((b) => b
              ..sortField = field
              ..sortAscending = ascending
            ),
          ));
        },
        sortFields: [
          // STARTER: constant fields - do not remove comment
SocialFields.userDisplayName,

SocialFields.userPhotoUrl,

SocialFields.content,

SocialFields.photos,

SocialFields.category,

SocialFields.likeCount,

SocialFields.commentCount,

SocialFields.tags,

        ],
         onSelectedState: (EntityState filterState, bool? value) {
          store.dispatch(FilterSocialsByState(filterState));
          if (value ?? false) {
            store.dispatch(UpdateSocialFilter(
              state.socialState.filter.rebuild((b) => b
                ..stateFilter = filterState
              ),
            ));
          }
        },
        onCheckboxPressed: () {
          if (store.state.socialListState.isInMultiselect()) {
            store.dispatch(ClearSocialMultiselect());
          } else {
            store.dispatch(StartSocialMultiselect());
          }
        },
        // // customValues1: userCompany.getCustomFieldValues(CustomFieldType.social1,
        // //     excludeBlank: true),
        // // customValues2: userCompany.getCustomFieldValues(CustomFieldType.social2,
        // //     excludeBlank: true),
        // // customValues3: userCompany.getCustomFieldValues(CustomFieldType.social3,
        // //     excludeBlank: true),
        // // customValues4: userCompany.getCustomFieldValues(CustomFieldType.social4,
        //     excludeBlank: true),
        // onSelectedCustom1: (value) =>
        //     store.dispatch(FilterSocialsByCustom1(value)),
        // onSelectedCustom2: (value) =>
        //     store.dispatch(FilterSocialsByCustom2(value)),
        // onSelectedCustom3: (value) =>
        //     store.dispatch(FilterSocialsByCustom3(value)),
        // onSelectedCustom4: (value) =>
        //     store.dispatch(FilterSocialsByCustom4(value)),
      ),
      floatingActionButton: state.prefState.isMenuFloated &&
              userCompany.canCreate(EntityType.social)
          ? FloatingActionButton(
              heroTag: 'social_fab',
              backgroundColor: Theme.of(context).primaryColorDark,
              onPressed: () {
                createEntityByType(
                    context: context, entityType: EntityType.social);
              },
              child: Icon(
                Icons.add,
                color: Colors.white,
              ),
              tooltip: localization.newSocial,
            )
          : null,
    );
  }
}
