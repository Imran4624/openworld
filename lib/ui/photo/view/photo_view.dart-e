import 'package:flutter/material.dart';
import 'package:flutter_boilerplate/ui/app/scrollable_listview.dart';
import 'package:flutter_boilerplate/ui/photo/view/photo_view_vm.dart';
import 'package:flutter_boilerplate/ui/app/view_scaffold.dart';
// STARTER: import - do not remove comment

class PhotoView extends StatefulWidget {

  const PhotoView({
    Key? key,
    required this.viewModel,
    required this.isFilter,
  }) : super(key: key);

  final PhotoViewVM viewModel;
  final bool isFilter;

  @override
  _PhotoViewState createState() => new _PhotoViewState();
}

class _PhotoViewState extends State<PhotoView> {
  @override
  Widget build(BuildContext context) {
    final viewModel = widget.viewModel;
    final photo = viewModel.photo;

    return ViewScaffold(
      isFilter: widget.isFilter,
      entity: photo,
      //STARTER: primary field - do not remove comment
title: photo.category,
      onBackPressed: () => viewModel.onBackPressed(),
      body: ScrollableListView(
        children: <Widget>[
          const SizedBox(height: 16.0),
          FieldGrid(
            {
             // STARTER: field grid - do not remove comment
PhotoFields.category: photo.category,
PhotoFields.storageType: photo.storageType.toString(),
PhotoFields.url: photo.url,
PhotoFields.isProcessed: photo.isProcessed.toString(),
PhotoFields.tags: photo.tags,
            },
          ),
        ],
      ),
    );
  }
}
