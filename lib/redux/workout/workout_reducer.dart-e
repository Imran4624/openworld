//   return workoutState.rebuild((b) {
//     for (final workout in action.workouts) {
//       b.map[workout.id] = workout;
//     }
//   });
// } 

StubState _deleteStubSuccess(
    StubState workoutState, DeleteStubsSuccess action) {
  return workoutState.rebuild((b) {
    for (final workout in action.workouts) {
      b.map[workout.id] = workoutState.map[workout.id]!.rebuild((b) => b
        ..isDeleted = true);
    }
  });
}

StubState _purgeStubSuccess(
    StubState workoutState, PurgeStubsSuccess action) {
  return workoutState.rebuild((b) {
    for (final workout in action.workouts) {
      b.map.remove(workout.id);
      b.list.remove(workout.id);
    }
  });
}

StubState _restoreStubSuccess(
    StubState workoutState, RestoreStubsSuccess action) {
  return workoutState.rebuild((b) {
    for (final workout in action.workouts) {
      b.map[workout.id] = workoutState.map[workout.id]!.rebuild((b) => b
        ..isDeleted = false
        ..archivedAt = 0);
    }
  });
}

StubState _addStub(StubState workoutState, AddStubSuccess action) {
  return workoutState.rebuild((b) => b
    ..map[action.workout.id] = action.workout
    ..list.add(action.workout.id));
}

StubState _updateStub(StubState workoutState, SaveStubSuccess action) {
  return workoutState.rebuild((b) => b..map[action.workout.id] = action.workout);
}
StubState _updateLastDocument(
    StubState workoutState, UpdateLastDocumentAction action) {
  return workoutState.rebuild((b) => b..lastDocument = action.lastDocument);
}

StubState _setLoadedStub(StubState workoutState, LoadStubSuccess action) {
  return workoutState.rebuild((b) => b..map[action.workout.id] = action.workout);
}

StubState _setLoadedStubs(
    StubState workoutState, LoadStubsSuccess action) {
  return workoutState.rebuild((b) {
    action.workouts.forEach((workout) {
      b.map[workout.id] = workout;
      if (!b.list.build().contains(workout.id)) {
        b.list.add(workout.id);
      }
    });
  });
}

