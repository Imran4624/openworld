StubState _deleteStubSuccess(
    StubState stubState, DeleteStubsSuccess action) {
  return stubState.rebuild((b) {
    for (final stub in action.stubs) {
      b.map[stub.id] = stubState.map[stub.id]!.rebuild((b) => b
        ..isDeleted = true);
    }
  });
}

StubState _purgeStubSuccess(
    StubState stubState, PurgeStubsSuccess action) {
  return stubState.rebuild((b) {
    for (final stub in action.stubs) {
      b.map.remove(stub.id);
      b.list.remove(stub.id);
    }
  });
}

StubState _restoreStubSuccess(
    StubState stubState, RestoreStubsSuccess action) {
  return stubState.rebuild((b) {
    for (final stub in action.stubs) {
      b.map[stub.id] = stubState.map[stub.id]!.rebuild((b) => b
        ..isDeleted = false
        ..archivedAt = 0);
    }
  });
}

StubState _addStub(StubState stubState, AddStubSuccess action) {
  return stubState.rebuild((b) => b
    ..map[action.stub.id] = action.stub
    ..list.add(action.stub.id));
}

StubState _updateStub(StubState stubState, SaveStubSuccess action) {
  return stubState.rebuild((b) => b..map[action.stub.id] = action.stub);
}
StubState _updateLastDocument(
    StubState stubState, UpdateLastDocumentAction action) {
  return stubState.rebuild((b) => b..lastDocument = action.lastDocument);
}

StubState _setLoadedStub(StubState stubState, LoadStubSuccess action) {
  return stubState.rebuild((b) => b..map[action.stub.id] = action.stub);
}

StubState _setLoadedStubs(
    StubState stubState, LoadStubsSuccess action) {
  return stubState.rebuild((b) {
    action.stubs.forEach((stub) {
      b.map[stub.id] = stub;
      if (!b.list.build().contains(stub.id)) {
        b.list.add(stub.id);
      }
    });
  });
}

