import 'dart:async';
import 'package:built_value/built_value.dart';
import 'package:built_value/serializer.dart';
import 'package:built_collection/built_collection.dart';
import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:flutter_boilerplate/redux/ui/entity_ui_state.dart';
import 'package:flutter_boilerplate/redux/ui/list_ui_state.dart';
import 'package:flutter_boilerplate/data/models/models.dart';
import 'package:flutter_boilerplate/redux/ui/pref_state.dart';

part 'event_state.g.dart';

abstract class EventState implements Built<EventState, EventStateBuilder> {
  factory EventState() {
    return _$EventState._(
      map: BuiltMap<String, EventEntity>(),
      list: BuiltList<String>(),
      lastDocument: null,
      filter: EventFilter(),
    );
  }
  EventState._();

  @override
  @memoized
  int get hashCode;

  BuiltMap<String, EventEntity> get map;
  BuiltList<String> get list;

  DocumentSnapshot? get lastDocument;
  EventFilter get filter;

  EventEntity get(String eventId) {
    return map[eventId] ?? EventEntity(id: eventId);
  }

  EventState loadEvents(BuiltList<EventEntity> clients) {
    final map = Map<String, EventEntity>.fromIterable(
      clients,
      key: (dynamic item) => item.id,
      value: (dynamic item) => item,
    );

    return rebuild((b) => b
      ..map.addAll(map)
      ..list.replace((map.keys.toList() + list.toList()).toSet().toList()));
  }

  static Serializer<EventState> get serializer => _$eventStateSerializer;
}

abstract class EventUIState extends Object
    with EntityUIState
    implements Built<EventUIState, EventUIStateBuilder> {
  factory EventUIState(PrefStateSortField? sortField) {
    return _$EventUIState._(
      listUIState: ListUIState(
        // STARTER: primary field - do not remove comment
        sortAscending: sortField?.ascending,
      ),
      editing: EventEntity(),
      selectedId: '',
      tabIndex: 0,
    );
  }
  EventUIState._();

  @override
  @memoized
  int get hashCode;

  EventEntity? get editing;

  @override
  bool get isCreatingNew => editing?.isNew ?? false;

  @override
  String get editingId => editing?.id ?? '';

  static Serializer<EventUIState> get serializer => _$eventUIStateSerializer;
}
