import 'package:flutter/material.dart';
import 'package:flutter_boilerplate/ui/app/edit_scaffold.dart';
import 'package:flutter_boilerplate/ui/app/form_card.dart';
import 'package:flutter_boilerplate/ui/profile/edit/profile_edit_vm.dart';
import 'package:flutter_boilerplate/utils/localization.dart';
import 'package:flutter_boilerplate/utils/completers.dart';
import 'package:flutter_boilerplate/ui/app/scrollable_listview.dart';

class ProfileEdit extends StatefulWidget {
  const ProfileEdit({
    Key? key,
    required this.viewModel,
  }) : super(key: key);

  final ProfileEditVM viewModel;

  @override
  _ProfileEditState createState() => _ProfileEditState();
}

class _ProfileEditState extends State<ProfileEdit> {
  static final GlobalKey<FormState> _formKey = GlobalKey<FormState>(debugLabel: '_profileEdit');
  final _debouncer = Debouncer();

  // STARTER: controllers - do not remove comment
final _nameController = TextEditingController();
  List<TextEditingController> _controllers = [];

  @override
  void didChangeDependencies() {
    _controllers = [
      // STARTER: array - do not remove comment
_nameController,
    ];

    _controllers.forEach((controller) => controller.removeListener(_onChanged));

    final profile = widget.viewModel.profile;
    // STARTER: read value - do not remove comment
_nameController.text = profile.name.toString();

    _controllers.forEach((controller) => controller.addListener(_onChanged));

    super.didChangeDependencies();
  }

  @override
  void dispose() {
    _controllers.forEach((controller) {
      controller.removeListener(_onChanged);
      controller.dispose();
    });

    super.dispose();
  }

  void _onChanged() {
    _debouncer.run(() {
      final profile = widget.viewModel.profile.rebuild((b) => b
        // STARTER: set value - do not remove comment
..name = _nameController.text.trim()
      );
      if (profile != widget.viewModel.profile) {
        widget.viewModel.onChanged(profile);
      }
    });
  }

  @override
  Widget build(BuildContext context) {
    final viewModel = widget.viewModel;
    final localization = AppLocalization.of(context)!;
    final profile = viewModel.profile;

    return EditScaffold(
      title: profile.isNew ? localization.newProfile : localization.editProfile,
      onCancelPressed: (context) => viewModel.onCancelPressed(context),
      onSavePressed: (context) {
        final bool isValid = _formKey.currentState!.validate();
        if (!isValid) {
          return;
        }
        viewModel.onSavePressed(context);
      },
      body: Form(
        key: _formKey,
        child: Builder(builder: (BuildContext context) {
          return ScrollableListView(
            children: <Widget>[
              FormCard(
                children: <Widget>[
                  // STARTER: widgets - do not remove comment
                ],
              ),
            ],
          );
        }),
      ),
    );
  }
}
