import 'package:built_value/built_value.dart';
import 'package:built_collection/built_collection.dart';
import 'package:built_value/serializer.dart';
import 'package:flutter_boilerplate/redux/app/app_state.dart';
import 'package:flutter_boilerplate/data/models/models.dart';
import 'package:flutter_boilerplate/utils/formatting.dart';
import 'package:flutter_boilerplate/utils/strings.dart';

part 'social_model.g.dart';

abstract class SocialFilter implements Built<SocialFilter, SocialFilterBuilder> {
  factory SocialFilter() {
    return _$SocialFilter._(
      searchTerm: '',
      stateFilter: EntityState.active,
      sortField: SocialFields.name,
      sortAscending: true,
      limit: 10, 
    );
  }

  SocialFilter._();

  @override
  @memoized
  int get hashCode;

  String get searchTerm;
  EntityState get stateFilter;
  String get sortField;
  bool get sortAscending;
  int get limit; 

  Map<String, dynamic> toFirebaseQuery() {
    final Map<String, dynamic> filters = {};
    
    // Handle search term
    if (searchTerm.isNotEmpty) {
      filters['title'] = searchTerm.toLowerCase();
    }

    // Handle state filter
    switch (stateFilter) {
      case EntityState.active:
        filters['archived_at'] = 0;
        filters['is_deleted'] = false;
        break;
      case EntityState.archived:
        filters['archived_at_gt'] = 0;
        filters['is_deleted'] = false;
        break;
      case EntityState.deleted:
        filters['is_deleted'] = true;
        break;
    }

    return {
      'filters': filters,
      'sort_field': sortField,
      'sort_ascending': sortAscending,
      'limit': limit
    };
  }

  static Serializer<SocialFilter> get serializer => _$socialFilterSerializer;
}

abstract class SocialListResponse
    implements Built<SocialListResponse, SocialListResponseBuilder> {
  factory SocialListResponse([void Function(SocialListResponseBuilder) updates]) =
      _$SocialListResponse;

  SocialListResponse._();

  @override
  @memoized
  int get hashCode;

  BuiltList<SocialEntity> get data;

  static Serializer<SocialListResponse> get serializer =>
      _$socialListResponseSerializer;
}

abstract class SocialItemResponse
    implements Built<SocialItemResponse, SocialItemResponseBuilder> {
  factory SocialItemResponse([void Function(SocialItemResponseBuilder) updates]) =
      _$SocialItemResponse;

  SocialItemResponse._();

  @override
  @memoized
  int get hashCode;

  SocialEntity get data;

  static Serializer<SocialItemResponse> get serializer =>
      _$socialItemResponseSerializer;
}

class SocialFields {
  // STARTER: fields - do not remove comment
static const String userDisplayName = 'userDisplayName';
static const String userPhotoUrl = 'userPhotoUrl';
static const String content = 'content';
static const String photos = 'photos';
static const String category = 'category';
static const String likeCount = 'likeCount';
static const String commentCount = 'commentCount';
static const String tags = 'tags';
}

abstract class SocialEntity extends Object
    with BaseEntity
    implements Built<SocialEntity, SocialEntityBuilder> {
  factory SocialEntity({String? id, AppState? state}) {
    return _$SocialEntity._(
      id: id ?? BaseEntity.nextId,
      isChanged: false,
      isDeleted: false,
      createdAt: 0,
      updatedAt: 0,
      createdUserId: '',
      assignedUserId: '',
      archivedAt: 0,
      // STARTER: constructor - do not remove comment
userDisplayName: '',
userPhotoUrl: '',
content: '',
photos: '',
category: '',
likeCount: 0,
commentCount: 0,
tags: '',
    );
  }

  SocialEntity._();

  @override
  @memoized
  int get hashCode;

  // STARTER: properties - do not remove comment
String get userDisplayName;
String get userPhotoUrl;
String get content;
String get photos;
String get category;
int get likeCount;
int get commentCount;
String get tags;

  @override
  EntityType get entityType => EntityType.social;

  @override
  List<EntityAction?> getActions({
    UserCompanyEntity? userCompany,
    bool includeEdit = false,
    bool multiselect = false,
  }) {
    final actions = <EntityAction?>[];

    if (!isDeleted! && !multiselect && includeEdit && userCompany?.canEditEntity(this) == true) {
      actions.add(EntityAction.edit);
    }

    if (!multiselect && userCompany?.canEditEntity(this) == true) {
      actions.add(EntityAction.purge);
    }

    if (actions.isNotEmpty) {
      actions.add(null);
    }

    return actions..addAll(super.getActions(userCompany: userCompany));
  }

  int compareTo(SocialEntity social, String sortField, bool sortAscending) {
    int response = 0;
    final socialA = sortAscending ? this : social;
    final socialB = sortAscending ? social : this;

    switch (sortField) {
      // STARTER: sort switch - do not remove comment
case SocialFields.userDisplayName:
response = socialA.userDisplayName.compareTo(socialB.userDisplayName);
break;

case SocialFields.userPhotoUrl:
response = socialA.userPhotoUrl.compareTo(socialB.userPhotoUrl);
break;

case SocialFields.content:
response = socialA.content.compareTo(socialB.content);
break;

case SocialFields.photos:
response = socialA.photos.compareTo(socialB.photos);
break;

case SocialFields.category:
response = socialA.category.compareTo(socialB.category);
break;

case SocialFields.tags:
response = socialA.tags.compareTo(socialB.tags);
break;

      default:
        logError('sort by social.$sortField is not implemented');
        break;
    }

    if (response == 0) {
      // STARTER: sort default - do not remove comment
    } else {
      return response;
    }
  }

  @override
  bool matchesFilter(String? filter) {
    return matchesStrings(
      haystacks: [
      // STARTER: field names - do not remove comment
userDisplayName,
userPhotoUrl,
content,
photos,
category,
tags,
      ],
      needle: filter,
    );
  }

  @override
  String? matchesFilterValue(String? filter) {
    return matchesStringsValue(
      haystacks: [
      // STARTER: field names - do not remove comment
userDisplayName,
userPhotoUrl,
content,
photos,
category,
tags,
      ],
      needle: filter,
    )!;
  }

  @override
  String get listDisplayName => '';

  @override
  double get listDisplayAmount => 0;

  @override
  FormatNumberType get listDisplayAmountType => FormatNumberType.int;

  static Serializer<SocialEntity> get serializer => _$socialEntitySerializer;
}
