import 'package:built_value/built_value.dart';
import 'package:built_collection/built_collection.dart';
import 'package:built_value/serializer.dart';
import 'package:flutter_boilerplate/redux/app/app_state.dart';
import 'package:flutter_boilerplate/data/models/models.dart';
import 'package:flutter_boilerplate/utils/formatting.dart';
import 'package:flutter_boilerplate/utils/strings.dart';

part 'profile_operation_model.g.dart';

abstract class ProfileOperationFilter implements Built<ProfileOperationFilter, ProfileOperationFilterBuilder> {
  factory ProfileOperationFilter() {
    return _$ProfileOperationFilter._(
      searchTerm: '',
      stateFilter: EntityState.active,
      sortField: ProfileOperationFields.name,
      sortAscending: true,
      limit: 10, 
    );
  }

  ProfileOperationFilter._();

  @override
  @memoized
  int get hashCode;

  String get searchTerm;
  EntityState get stateFilter;
  String get sortField;
  bool get sortAscending;
  int get limit; 

  Map<String, dynamic> toFirebaseQuery() {
    final Map<String, dynamic> filters = {};
    
    // Handle search term
    if (searchTerm.isNotEmpty) {
      filters['title'] = searchTerm.toLowerCase();
    }

    // Handle state filter
    switch (stateFilter) {
      case EntityState.active:
        filters['archived_at'] = 0;
        filters['is_deleted'] = false;
        break;
      case EntityState.archived:
        filters['archived_at_gt'] = 0;
        filters['is_deleted'] = false;
        break;
      case EntityState.deleted:
        filters['is_deleted'] = true;
        break;
    }

    return {
      'filters': filters,
      'sort_field': sortField,
      'sort_ascending': sortAscending,
      'limit': limit
    };
  }

  static Serializer<ProfileOperationFilter> get serializer => _$profileOperationFilterSerializer;
}

abstract class ProfileOperationListResponse
    implements Built<ProfileOperationListResponse, ProfileOperationListResponseBuilder> {
  factory ProfileOperationListResponse([void Function(ProfileOperationListResponseBuilder) updates]) =
      _$ProfileOperationListResponse;

  ProfileOperationListResponse._();

  @override
  @memoized
  int get hashCode;

  BuiltList<ProfileOperationEntity> get data;

  static Serializer<ProfileOperationListResponse> get serializer =>
      _$profileOperationListResponseSerializer;
}

abstract class ProfileOperationItemResponse
    implements Built<ProfileOperationItemResponse, ProfileOperationItemResponseBuilder> {
  factory ProfileOperationItemResponse([void Function(ProfileOperationItemResponseBuilder) updates]) =
      _$ProfileOperationItemResponse;

  ProfileOperationItemResponse._();

  @override
  @memoized
  int get hashCode;

  ProfileOperationEntity get data;

  static Serializer<ProfileOperationItemResponse> get serializer =>
      _$profileOperationItemResponseSerializer;
}

class ProfileOperationFields {
  // STARTER: fields - do not remove comment
static const String status = 'status';
static const String comment = 'comment';
static const String type = 'type';
}

abstract class ProfileOperationEntity extends Object
    with BaseEntity
    implements Built<ProfileOperationEntity, ProfileOperationEntityBuilder> {
  factory ProfileOperationEntity({String? id, AppState? state}) {
    return _$ProfileOperationEntity._(
      id: id ?? BaseEntity.nextId,
      isChanged: false,
      isDeleted: false,
      createdAt: 0,
      updatedAt: 0,
      createdUserId: '',
      assignedUserId: '',
      archivedAt: 0,
      // STARTER: constructor - do not remove comment
status: 0,
comment: '',
type: 0,
    );
  }

  ProfileOperationEntity._();

  @override
  @memoized
  int get hashCode;

  // STARTER: properties - do not remove comment
int get status;
String get comment;
int get type;

  @override
  EntityType get entityType => EntityType.profileOperation;

  @override
  List<EntityAction?> getActions({
    UserCompanyEntity? userCompany,
    bool includeEdit = false,
    bool multiselect = false,
  }) {
    final actions = <EntityAction?>[];

    if (!isDeleted! && !multiselect && includeEdit && userCompany?.canEditEntity(this) == true) {
      actions.add(EntityAction.edit);
    }

    if (!multiselect && userCompany?.canEditEntity(this) == true) {
      actions.add(EntityAction.purge);
    }

    if (actions.isNotEmpty) {
      actions.add(null);
    }

    return actions..addAll(super.getActions(userCompany: userCompany));
  }

  int compareTo(ProfileOperationEntity profileOperation, String sortField, bool sortAscending) {
    int response = 0;
    final profileOperationA = sortAscending ? this : profileOperation;
    final profileOperationB = sortAscending ? profileOperation : this;

    switch (sortField) {
      // STARTER: sort switch - do not remove comment
case ProfileOperationFields.comment:
response = profileOperationA.comment.compareTo(profileOperationB.comment);
break;

      default:
        logError('sort by profileOperation.$sortField is not implemented');
        break;
    }

    if (response == 0) {
      // STARTER: sort default - do not remove comment
    } else {
      return response;
    }
  }

  @override
  bool matchesFilter(String? filter) {
    return matchesStrings(
      haystacks: [
      // STARTER: field names - do not remove comment
comment,
      ],
      needle: filter,
    );
  }

  @override
  String? matchesFilterValue(String? filter) {
    return matchesStringsValue(
      haystacks: [
      // STARTER: field names - do not remove comment
comment,
      ],
      needle: filter,
    )!;
  }

  @override
  String get listDisplayName => '';

  @override
  double get listDisplayAmount => 0;

  @override
  FormatNumberType get listDisplayAmountType => FormatNumberType.int;

  static Serializer<ProfileOperationEntity> get serializer => _$profileOperationEntitySerializer;
}
